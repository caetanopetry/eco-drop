Options -MultiViews

DirectoryIndex index.php

# Cabeçalhos de proteção para todas as respostas, quando mod_headers estiver
# habilitado no Apache (padrão no XAMPP). A CSP mantém apenas as origens usadas
# pela aplicação: recursos locais, Google Fonts, fotos HTTPS e imagens de perfil.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'none'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self'"
</IfModule>

RewriteEngine On

# Arquivos de configuração, versionamento e banco não são recursos públicos.
<FilesMatch "(^\.|\.(sql|log|bak|ini|phar|lock)$|^(composer|package)(-lock)?\.json$)">
    Require all denied
</FilesMatch>
RewriteRule ^(\.git|vendor|tests|backend/(config|core|database|repositories|services))(/|$) - [F,L,NC]

# Impede o acesso direto aos fragmentos de página usados pelo layout.
RewriteRule ^frontend/pages/institucional/(layout|sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)\.php$ - [F,L,NC]

# A antiga interface da estação foi removida.
RewriteRule ^station/?$ - [R=404,L,NC]

# Mantém uma única versão das URLs institucionais, sempre com barra final.
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)$ %{REQUEST_URI}/ [R=301,L,NE]

# Rotas de autenticação do Google.
RewriteRule ^auth/google/?$ auth/google/index.php [L,NC]
RewriteRule ^auth/google/callback/?$ auth/google/callback/index.php [L,NC]

# Arquivos e diretórios reais continuam sendo servidos normalmente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# As páginas institucionais passam pelo controlador principal.
RewriteRule ^(sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)/$ index.php?pagina=$1 [QSA,L,NC]
