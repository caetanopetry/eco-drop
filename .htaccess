Options -MultiViews

DirectoryIndex index.php

RewriteEngine On

# Impede o acesso direto aos fragmentos de página usados pelo layout.
RewriteRule ^frontend/pages/institucional/(layout|sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)\.php$ - [F,L,NC]

# Mantém uma única versão das URLs institucionais, sempre com barra final.
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)$ %{REQUEST_URI}/ [R=301,L,NE]

# Rotas de autenticação do Google.
RewriteRule ^auth/google/?$ auth/google/index.php [L,NC]
RewriteRule ^auth/google/callback/?$ auth/google/callback/index.php [L,NC]

# Arquivos e diretórios reais continuam sendo servidos normalmente.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# As páginas institucionais passam pelo controlador principal.
RewriteRule ^(sobre|contato|perguntas-frequentes|termos-de-uso|politica-de-privacidade)/$ index.php?pagina=$1 [QSA,L,NC]
